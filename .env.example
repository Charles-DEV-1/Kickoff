APP_ENV=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256
SUPPORTED_LANGUAGES=en
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Set only when this API is behind a known, fixed number of trusted proxies.
PUBLIC_RATE_LIMIT_TRUSTED_PROXY_HOPS=0
# Optional overrides; defaults are derived from SUPABASE_URL.
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_ISSUER=
# Only for a legacy HS256 project. Keep server-side and never use with ES256.
# SUPABASE_JWT_SECRET=
# Server-only key for Auth deletion and narrowly granted retention RPCs.
SUPABASE_SECRET_KEY=
# Vercel Cron bearer secret for /internal/jobs/purge; server only.
CRON_SECRET=
# Groq is selected for the MVP. Without GROQ_API_KEY, the API uses templates.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_DAILY_ALLOWANCE=10
AI_PROVIDER_DAILY_BUDGET=1000
AI_CACHE_TTL_SECONDS=86400
# Server-only random secret (minimum 32 characters); HMACs normalized/redacted cache keys.
AI_CACHE_HMAC_KEY=
AI_PROVIDER_TIMEOUT_SECONDS=5
AI_TOTAL_BUDGET_SECONDS=8
